# Django Settings
# DJANGO_DEBUG=True enables the development defaults. With debug off, replace DJANGO_SECRET_KEY
# and CHATBOT_USER_TOKEN_SECRET with real values or the server will not start.
DJANGO_SECRET_KEY=django-insecure-dev-key-change-in-production
DJANGO_DEBUG=True

# Anthropic API (Required)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=<your-anthropic-api-key-here>

BRAINTRUST_API_KEY=<your-braintrust-api-key-here>
BRAINTRUST_PROJECT=<your-braintrust-project-name-here>
BRAINTRUST_LOGGING_ENABLED=False

CORE_PROMPT_SLUG=core-8fbc


DB_NAME=<your-db-name-here>
DB_USER=<your-db-user-here>
DB_PASSWORD=<your-db-password-here>
DB_HOST=<your-db-host-here>
DB_PORT=<your-db-port-here>

CHATBOT_USER_TOKEN_SECRET=<your-chatbot-user-token-secret-here>

# Semantic search API token (required for /api/knn-search on Sefaria)
SEMANTIC_SEARCH_API_TOKEN=<your-semantic-search-api-token-here>

# Sefaria API key (optional). Sent as the x-api-key header on every Sefaria API request,
# next to the Bearer token that knn-search also needs. Leave unset to send no key.
# Goes in chatbot-env, not chatbot-mcp-env (the chatbot pod loads both, so the MCP would get it).
SEFARIA_API_KEY=<your-sefaria-api-key-here>

# Extra exact hostnames that get the key (comma-separated), beyond the request's Sefaria on
# sefaria.org, sefaria.org.il, sefariapreprod.org or sefariapreprod-il.org; e.g. a staging or
# in-cluster host. Optional.
# SEFARIA_API_KEY_EXTRA_HOSTS=www.sefariastaging.org

# Sefaria API key for the public MCP server only (optional). Sent as the x-api-key header on its
# Sefaria API requests. The chatbot never reads this variable, and the MCP server never reads
# SEFARIA_API_KEY. Leave unset to send no key.
MCP_SEFARIA_API_KEY=<your-mcp-sefaria-api-key-here>
